{
  "permissions": {
    "allow": [
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)", "Bash(git pull:*)", "Bash(git fetch:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git push origin dev)",
      "Bash(git tag v*)", "Bash(git push origin v*)",
      "Bash(gh run list:*)", "Bash(gh run view:*)", "Bash(gh run watch:*)",
      "Bash(gh issue list:*)", "Bash(gh issue view:*)", "Bash(gh issue comment:*)", "Bash(gh issue close:*)",
      "Bash(gh release view:*)", "Bash(rg:*)", "Bash(python3:*)",
      "Read(~/workspace/CFG/telemetry-ingest/**)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push --force-with-lease:*)", "Bash(git push origin +*)",
      "Bash(git push origin --tags:*)", "Bash(git push --delete:*)", "Bash(git push origin --delete:*)", "Bash(git push origin ::*)",
      "Bash(git tag -d:*)", "Bash(git tag --delete:*)", "Bash(git tag -f:*)",
      "Bash(gh release delete:*)", "Bash(gh release edit:*)", "Bash(gh secret:*)",
      "Read(~/workspace/CFG/private/**)", "Bash(cat ~/workspace/CFG/private/*)"
    ],
    "additionalDirectories": ["~/workspace/CFG/telemetry-ingest"]
  }
}
