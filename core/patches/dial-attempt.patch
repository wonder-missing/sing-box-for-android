index b2fc3ef..fb0c192 100644
--- a/common/dialer/detour.go
+++ b/common/dialer/detour.go
@@ -97,3 +97,21 @@ func (d *DetourDialer) Upstream() any {
 	detour, _ := d.Dialer()
 	return detour
 }
+
+// IsDetour reports whether d opens a stream through another outbound instead
+// of a raw socket. Domain resolvers wrapped around a detour still count.
+func IsDetour(d N.Dialer) bool {
+	for i := 0; i < 4 && d != nil; i++ {
+		switch v := d.(type) {
+		case *DetourDialer:
+			return true
+		case *resolveDialer:
+			d = v.dialer
+		case *resolveParallelNetworkDialer:
+			d = v.dialer
+		default:
+			return false
+		}
+	}
+	return false
+}
diff --git a/common/dialreport/report.go b/common/dialreport/report.go
new file mode 100644
index 0000000..e17442a
--- /dev/null
+++ b/common/dialreport/report.go
@@ -0,0 +1,222 @@
+package dialreport
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/common/dialer"
+	N "github.com/sagernet/sing/common/network"
+)
+
+const (
+	CauseTraffic = "traffic"
+	CauseURLTest = "urltest"
+)
+
+// maxAttempts is the in-process ring size. The Android side drains it every
+// couple of seconds; when the ring is full the oldest attempt is dropped.
+var maxAttempts = 256
+
+type causeKey struct{}
+
+// WithCause marks a dial as urltest (or any other cause) so a health query
+// can exclude node-selection probes from user-experience dials.
+func WithCause(ctx context.Context, cause string) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	if cause == "" {
+		cause = CauseTraffic
+	}
+	return context.WithValue(ctx, causeKey{}, cause)
+}
+
+func causeOf(ctx context.Context) string {
+	if ctx == nil {
+		return CauseTraffic
+	}
+	cause, _ := ctx.Value(causeKey{}).(string)
+	if cause == "" {
+		return CauseTraffic
+	}
+	return cause
+}
+
+type attempt struct {
+	TS         int64  `json:"ts"`
+	Outbound   string `json:"outbound"`
+	Network    string `json:"network"`
+	Entry      string `json:"entry,omitempty"`
+	Result     string `json:"result"`
+	ErrorClass string `json:"error_class,omitempty"`
+	DurationMS int64  `json:"duration_ms"`
+	Cause      string `json:"cause"`
+}
+
+var (
+	mu    sync.Mutex
+	queue []attempt
+)
+
+// MeasureDirect records one entry dial unless [d] is a detour. A detour opens
+// a stream through another outbound; that outbound records the real entry.
+func MeasureDirect(ctx context.Context, d N.Dialer, outbound, network, server string, dial func(context.Context) (net.Conn, error)) (net.Conn, error) {
+	if dialer.IsDetour(d) {
+		return dial(ctx)
+	}
+	return Measure(ctx, outbound, network, server, dial)
+}
+
+// MeasureDirectServer is MeasureDirect that always stores the configured
+// server. Socks UDP associate and legacy UoT set RemoteAddr to the user
+// destination, which must not be uploaded as the proxy entry.
+func MeasureDirectServer(ctx context.Context, d N.Dialer, outbound, network, server string, dial func(context.Context) (net.Conn, error)) (net.Conn, error) {
+	if dialer.IsDetour(d) {
+		return dial(ctx)
+	}
+	if dial == nil {
+		return nil, errors.New("nil dial")
+	}
+	started := time.Now()
+	conn, err := dial(ctx)
+	Finish(ctx, outbound, network, server, nil, err, started)
+	return conn, err
+}
+
+// Measure times one proxy-entry dial, success and failure, and returns the
+// dial result unchanged. The entry stored is RemoteAddr when the connection
+// exists, otherwise the configured server address.
+func Measure(ctx context.Context, outbound, network, server string, dial func(context.Context) (net.Conn, error)) (net.Conn, error) {
+	if dial == nil {
+		return nil, errors.New("nil dial")
+	}
+	started := time.Now()
+	conn, err := dial(ctx)
+	var addr net.Addr
+	if conn != nil {
+		addr = conn.RemoteAddr()
+	}
+	Finish(ctx, outbound, network, server, addr, err, started)
+	return conn, err
+}
+
+// Finish records a dial that the caller already performed.
+func Finish(ctx context.Context, outbound, network, server string, addr net.Addr, err error, started time.Time) {
+	if strings.TrimSpace(outbound) == "" {
+		return
+	}
+	entry := ""
+	if addr != nil {
+		entry = addr.String()
+	}
+	if entry == "" || entry == "<nil>" {
+		entry = server
+	}
+	entry = cleanEntry(entry)
+	duration := time.Since(started).Milliseconds()
+	if duration < 0 {
+		duration = 0
+	}
+	result := "ok"
+	class := ""
+	if err != nil {
+		result = "fail"
+		class = classify(err)
+	}
+	item := attempt{
+		TS:         started.UnixMilli(),
+		Outbound:   truncate(outbound, 80),
+		Network:    truncate(network, 16),
+		Entry:      entry,
+		Result:     result,
+		ErrorClass: class,
+		DurationMS: duration,
+		Cause:      causeOf(ctx),
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	limit := maxAttempts
+	if limit < 1 {
+		limit = 1
+	}
+	if len(queue) >= limit {
+		drop := len(queue) - limit + 1
+		queue = append([]attempt(nil), queue[drop:]...)
+	}
+	queue = append(queue, item)
+}
+
+// DrainJSON returns every buffered attempt as a JSON array and clears the ring.
+// An empty ring is "[]", never an empty string.
+func DrainJSON() string {
+	mu.Lock()
+	items := queue
+	queue = nil
+	mu.Unlock()
+	if len(items) == 0 {
+		return "[]"
+	}
+	raw, err := json.Marshal(items)
+	if err != nil {
+		return "[]"
+	}
+	return string(raw)
+}
+
+func classify(err error) string {
+	if err == nil {
+		return ""
+	}
+	s := strings.ToLower(err.Error())
+	switch {
+	case strings.Contains(s, "i/o timeout"):
+		return "io_timeout"
+	case strings.Contains(s, "deadline exceeded") || errors.Is(err, context.DeadlineExceeded):
+		return "deadline"
+	case strings.Contains(s, "reset by peer"):
+		return "reset"
+	case strings.Contains(s, "unexpected eof"):
+		return "unexpected_eof"
+	case strings.Contains(s, "refused"):
+		return "refused"
+	case strings.Contains(s, "no route") || strings.Contains(s, "unreachable"):
+		return "unreachable"
+	case strings.Contains(s, "tls") || strings.Contains(s, "certificate") || strings.Contains(s, "handshake"):
+		return "tls"
+	case strings.Contains(s, "no such host") || strings.Contains(s, "server misbehaving") || strings.Contains(s, "dns"):
+		return "dns"
+	case strings.Contains(s, " eof") || strings.HasSuffix(s, "eof") || s == "eof":
+		return "eof"
+	default:
+		return "other"
+	}
+}
+
+func cleanEntry(s string) string {
+	s = strings.TrimSpace(s)
+	if i := strings.Index(s, "://"); i >= 0 {
+		s = s[i+3:]
+	}
+	if at := strings.LastIndex(s, "@"); at >= 0 {
+		s = s[at+1:]
+	}
+	s = strings.Map(func(r rune) rune {
+		if r < 0x20 || r == '"' || r == '\\' {
+			return -1
+		}
+		return r
+	}, s)
+	return truncate(s, 160)
+}
+
+func truncate(s string, max int) string {
+	if len(s) <= max {
+		return s
+	}
+	return s[:max]
+}
diff --git a/common/dialreport/report_test.go b/common/dialreport/report_test.go
new file mode 100644
index 0000000..68e4858
--- /dev/null
+++ b/common/dialreport/report_test.go
@@ -0,0 +1,152 @@
+package dialreport
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net"
+	"testing"
+	"time"
+)
+
+type addrConn struct {
+	addr net.Addr
+}
+
+func (c addrConn) Read([]byte) (int, error)         { return 0, errors.New("unused") }
+func (c addrConn) Write([]byte) (int, error)        { return 0, errors.New("unused") }
+func (c addrConn) Close() error                     { return nil }
+func (c addrConn) LocalAddr() net.Addr              { return c.addr }
+func (c addrConn) RemoteAddr() net.Addr             { return c.addr }
+func (c addrConn) SetDeadline(time.Time) error      { return nil }
+func (c addrConn) SetReadDeadline(time.Time) error  { return nil }
+func (c addrConn) SetWriteDeadline(time.Time) error { return nil }
+
+func resetRing() {
+	mu.Lock()
+	queue = nil
+	maxAttempts = 256
+	mu.Unlock()
+}
+
+func TestMeasureSuccessUsesRemoteAddr(t *testing.T) {
+	resetRing()
+	conn, err := Measure(context.Background(), "proxy-a", "tcp", "example.com:443", func(context.Context) (net.Conn, error) {
+		return addrConn{addr: &net.TCPAddr{IP: net.IPv4(1, 2, 3, 4), Port: 443}}, nil
+	})
+	if err != nil || conn == nil {
+		t.Fatalf("dial returned %v %v", conn, err)
+	}
+	var got []attempt
+	if err := json.Unmarshal([]byte(DrainJSON()), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 {
+		t.Fatalf("attempts=%d", len(got))
+	}
+	if got[0].Result != "ok" || got[0].ErrorClass != "" {
+		t.Fatalf("result=%s class=%s", got[0].Result, got[0].ErrorClass)
+	}
+	if got[0].Entry != "1.2.3.4:443" {
+		t.Fatalf("entry=%s", got[0].Entry)
+	}
+	if got[0].Cause != CauseTraffic || got[0].Outbound != "proxy-a" || got[0].Network != "tcp" {
+		t.Fatalf("attempt=%+v", got[0])
+	}
+	if got[0].TS <= 0 {
+		t.Fatalf("ts=%d", got[0].TS)
+	}
+	if DrainJSON() != "[]" {
+		t.Fatal("ring was not cleared")
+	}
+}
+
+func TestMeasureFailureClassAndURLTestCause(t *testing.T) {
+	resetRing()
+	ctx := WithCause(context.Background(), CauseURLTest)
+	_, err := Measure(ctx, "proxy-b", "tcp", "cdn.example:443", func(context.Context) (net.Conn, error) {
+		return nil, errors.New("dial tcp 9.9.9.9:443: connect: connection refused")
+	})
+	if err == nil {
+		t.Fatal("expected dial error")
+	}
+	var got []attempt
+	if err := json.Unmarshal([]byte(DrainJSON()), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 {
+		t.Fatalf("attempts=%d", len(got))
+	}
+	if got[0].Result != "fail" || got[0].ErrorClass != "refused" {
+		t.Fatalf("result=%s class=%s", got[0].Result, got[0].ErrorClass)
+	}
+	if got[0].Cause != CauseURLTest {
+		t.Fatalf("cause=%s", got[0].Cause)
+	}
+	if got[0].Entry != "cdn.example:443" {
+		t.Fatalf("entry=%s", got[0].Entry)
+	}
+}
+
+func TestClassify(t *testing.T) {
+	cases := []struct {
+		err  string
+		want string
+	}{
+		{"read: i/o timeout", "io_timeout"},
+		{"context deadline exceeded", "deadline"},
+		{"read: connection reset by peer", "reset"},
+		{"unexpected EOF", "unexpected_eof"},
+		{"EOF", "eof"},
+		{"connect: connection refused", "refused"},
+		{"connect: network is unreachable", "unreachable"},
+		{"tls: handshake failure", "tls"},
+		{"lookup example.com: no such host", "dns"},
+		{"something else", "other"},
+	}
+	for _, tc := range cases {
+		if got := classify(errors.New(tc.err)); got != tc.want {
+			t.Errorf("%q -> %s, want %s", tc.err, got, tc.want)
+		}
+	}
+}
+
+func TestRingDropsOldest(t *testing.T) {
+	resetRing()
+	maxAttempts = 2
+	for _, tag := range []string{"a", "b", "c"} {
+		_, _ = Measure(context.Background(), tag, "tcp", "127.0.0.1:1", func(context.Context) (net.Conn, error) {
+			return nil, errors.New("connection refused")
+		})
+	}
+	var got []attempt
+	if err := json.Unmarshal([]byte(DrainJSON()), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got[0].Outbound != "b" || got[1].Outbound != "c" {
+		t.Fatalf("queue=%+v", got)
+	}
+}
+
+func TestCleanEntryStripsUserinfo(t *testing.T) {
+	if got := cleanEntry("https://user:secret@entry.example:443/path"); got != "entry.example:443/path" {
+		t.Fatalf("got %q", got)
+	}
+}
+
+func TestMeasureDirectServerIgnoresUserDestination(t *testing.T) {
+	resetRing()
+	_, err := MeasureDirectServer(context.Background(), nil, "socks-out", "udp", "proxy.example:1080", func(context.Context) (net.Conn, error) {
+		return addrConn{addr: &net.UDPAddr{IP: net.IPv4(8, 8, 8, 8), Port: 53}}, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got []attempt
+	if err := json.Unmarshal([]byte(DrainJSON()), &got); err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 1 || got[0].Entry != "proxy.example:1080" || got[0].Network != "udp" {
+		t.Fatalf("attempt=%+v", got)
+	}
+}
